{
  "manifest_version": 3,
  "name": "带货视频助手",
  "version": "2.1.0",
  "description": "实时监测页面视频并添加下载按钮，方便用户快速下载视频文件 - 强制更新版",
  "homepage_url": "https://2011shao.github.io/videodown/index.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://compass.jinritemai.com/*"
  ],
  "permissions": [
    "webRequest"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "带货视频助手 - 版本: 2.1.0"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://compass.jinritemai.com/*", "https://www.douyin.com/*"],
      "js": ["content.js"]
    }
  ]
}
